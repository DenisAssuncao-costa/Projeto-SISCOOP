{
  "name": "siscoop",
  "version": "1.0.0",
  "description": "SISCOOP - Sistema de Gestao de Estoque e Venda para Cooperativa de Artesanato Ribeirinho",
  "main": "main.js",
  "author": "Marcelo Aguiar de Barros",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.siscoop.app",
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@31.0.0": true,
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true
  }
}
